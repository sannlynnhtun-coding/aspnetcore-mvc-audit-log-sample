@model IReadOnlyList<User>
@{
    ViewData["Title"] = "Users";
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Users</h1>
        <p class="mt-1 text-sm text-gray-500">Manage users with full audit trail (Create → Pending → Approve/Reject)</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center justify-center px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-lg shadow-sm transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Create User
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Limit</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                        No users yet. Create one to start the audit flow.
                    </td>
                </tr>
            }
            @foreach (var user in Model)
            {
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-semibold">
                                @user.Name[0]
                            </div>
                            <div class="ml-4">
                                <div class="text-sm font-medium text-gray-900">@user.Name</div>
                                <div class="text-sm text-gray-500">@user.Email</div>
                                @if (!string.IsNullOrWhiteSpace(user.MobileNo))
                                {
                                    <div class="text-xs text-gray-500">@user.MobileNo</div>
                                }
                                <div class="text-xs text-gray-400 font-mono">@user.Id</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">
                        @user.Limit.ToString("N0")
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        @if (user.Status == "Pending")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-warning-50 text-warning-600 border border-warning-500/20">
                                Pending
                            </span>
                        }
                        else if (user.Status == "Approved")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-success-50 text-success-700 border border-success-500/20">
                                Approved
                            </span>
                        }
                        else if (user.Status == "Rejected")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-danger-50 text-danger-700 border border-danger-500/20">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                                @user.Status
                            </span>
                        }
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        @user.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                        <a asp-action="Details" asp-route-id="@user.Id"
                           class="text-primary-600 hover:text-primary-800">Details</a>
                        <a asp-action="Edit" asp-route-id="@user.Id"
                           class="text-gray-600 hover:text-gray-900">Edit</a>

                        @if (user.Status == "Pending")
                        {
                            <form asp-action="Approve" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <input type="hidden" name="reason" value="Approved via list" />
                                <button type="submit" class="text-success-600 hover:text-success-800">Approve</button>
                            </form>
                            <form asp-action="Reject" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <input type="hidden" name="reason" value="Rejected via list" />
                                <button type="submit" class="text-danger-600 hover:text-danger-800">Reject</button>
                            </form>
                        }

                        <form asp-action="Delete" method="post" class="inline"
                              onsubmit="return confirm('Delete this user? This will be audited.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <input type="hidden" name="reason" value="Deleted from list" />
                            <button type="submit" class="text-danger-600 hover:text-danger-800">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
